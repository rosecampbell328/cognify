# Copy to .env.local and fill in. .env.local is ignored by git.

# AI course building (server only; never prefix with EXPO_PUBLIC_)
ANTHROPIC_API_KEY=

# Accounts, sharing and friends (see README → "Turn on sharing and friends")
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your website for share links, and store listings once published
EXPO_PUBLIC_SHARE_URL=
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
